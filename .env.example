# PersonalServer Environment Configuration Template
# =============================================================================
# Copy this file to .env or export these variables in your shell.
# All settings have safe built-in defaults; uncomment and customize as needed.

# -----------------------------------------------------------------------------
# Controller Network & Binding
# -----------------------------------------------------------------------------
# Host address to bind the controller HTTP server
PERSONALSERVER_CONTROLLER_HOST=127.0.0.1

# Port for the controller API (default: 8000)
PERSONALSERVER_CONTROLLER_PORT=8000

# Router binding port for application reverse proxy (default: 8088)
PERSONALSERVER_ROUTER_PORT=8088

# -----------------------------------------------------------------------------
# Cluster & Heartbeat Timings (seconds)
# -----------------------------------------------------------------------------
# Node heartbeat timeout before marked OFFLINE (default: 60)
PERSONALSERVER_HEARTBEAT_TIMEOUT=60

# Lease grace period for active job reassignment upon node loss (default: 20)
PERSONALSERVER_LEASE_GRACE_SEC=20

# Time-to-live for dynamic node onboarding pairing codes (default: 900 / 15m)
PERSONALSERVER_ONBOARDING_TTL_SEC=900

# -----------------------------------------------------------------------------
# Filesystem Paths (Defaults are relative to repository root)
# Override these for isolated testing or FHS-compliant Linux service layout
# -----------------------------------------------------------------------------
# PERSONALSERVER_BASE_DIR=/path/to/PersonalServer
# PERSONALSERVER_DATA_DIR=/path/to/PersonalServer/controller/data
# PERSONALSERVER_CONFIG_DIR=/path/to/PersonalServer/config
# PERSONALSERVER_SECRETS_DIR=/path/to/PersonalServer/config/secrets
# PERSONALSERVER_RUNTIME_DIR=/path/to/PersonalServer/runtime
# PERSONALSERVER_LOGS_DIR=/path/to/PersonalServer/logs
# PERSONALSERVER_STORAGE_DIR=/path/to/PersonalServer/storage

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# Set to 1 to enable verbose debug logging in controller and executor
PERSONALSERVER_DEBUG=0
