# Local node configuration
config/node.json
config/network.json
config/services.json

# Secrets
config/secrets/*
!config/secrets/*.example*
!config/secrets/.gitkeep
*.key
*.pem
*.token
!*.example.token
*.secret

# Runtime & Persistence
logs/
runtime/
data/
controller/data/
backups/
*.tar.gz
*.tar
*.zip
.pytest_cache/
.ruff_cache/
*.pid
*.bak


# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Ephemeral application sandboxes
storage/applications/*/
!storage/applications/.gitkeep
storage/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
node_modules/
.DS_Store
Thumbs.db