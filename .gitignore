# Local node configuration
config/node.json
config/node.conf
config/controller.json
config/network.json
config/services.json

# Environment variables & secrets
.env
!.env.example
config/secrets/*
!config/secrets/*.example*
!config/secrets/.gitkeep
*.key
*.pem
*.token
!*.example.token
*.secret

# Scratch & temporary development scripts
scratch/*
!scratch/README.md
!scratch/*.py

# Runtime & Persistence
logs/
runtime/
data/
controller/data/
backups/
*.tar.gz
*.tar
*.zip
*.pid
*.bak

# Testing & quality artifacts
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Ephemeral application sandboxes & storage runtime
storage/applications/*/
!storage/applications/.gitkeep
storage/uploads/
storage/temp/
storage/artifacts/
!storage/images/
!storage/images/*.json

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
node_modules/
.DS_Store
Thumbs.db